# Guaranteed offline judging path. Set false to try the configured AI endpoint.
DEMO_MODE=true

# Any OpenAI-compatible inference endpoint. These values are server-only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Optional account persistence. The tutor and demo mode do not require Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if cron routes are added.
CRON_SECRET=
CRON_SECRET_PREVIOUS=

